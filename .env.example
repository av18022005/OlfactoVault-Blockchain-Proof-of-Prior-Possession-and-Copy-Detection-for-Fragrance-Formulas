# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. Use a throwaway test wallet with no real funds.

# RPC URL for the Sepolia test network (free from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Private key of a TEST-ONLY wallet (never a wallet that holds real money)
PRIVATE_KEY=your_test_wallet_private_key_here

# Etherscan API key (only needed to verify the contract's source code)
ETHERSCAN_API_KEY=your_etherscan_key_here
